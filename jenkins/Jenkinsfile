pipeline {
    agent any
    tools {
        nodejs "node266"
    }
    stages {
        stage('Build') { 
            steps {
                sh 'npm install' 
            }
        }
        stage('Test') {
            steps{
                sh './jenkins/scripts/test.sh'
            }
        }
        stage('Deliver') {
            steps {
                sh './jenkins/scripts/deliver.sh'
                input message: 'Finished using the web site? (Click "Processed" to continue)'
                sh './jenkins/scripts/kill.sh'
            }
        }
    }
}